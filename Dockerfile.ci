# The image CI publishes, from a binary CI has built already (see .github/workflows/ci.yml): rebuilding inside
# Docker would compile everything from scratch on every run. The Dockerfile next to this one builds the same image
# from source.
FROM scratch
COPY ci-rootfs/ /
USER 65534:65534
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD ["/grabarr", "healthcheck"]
ENTRYPOINT ["/grabarr"]
