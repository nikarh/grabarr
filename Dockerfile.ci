# The image CI publishes, from a binary CI has built already (see .github/workflows/publish.yml): rebuilding inside
# Docker would compile everything from scratch on every run. The Dockerfile next to this one builds the same image
# from source.
FROM scratch
COPY ci-rootfs/ /
LABEL org.opencontainers.image.source="https://github.com/nikarh/grabarr" \
      org.opencontainers.image.description="Search Prowlarr, grab to qBittorrent, watch the downloads" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
USER 65534:65534
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD ["/grabarr", "healthcheck"]
ENTRYPOINT ["/grabarr"]
